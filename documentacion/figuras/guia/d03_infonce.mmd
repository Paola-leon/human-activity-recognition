    CT["<b>c<sub>t</sub></b><br/>contexto de la ventana A<br/>en el instante t"] --> W["<b>W<sub>k</sub> · c<sub>t</sub></b><br/>predicción de<br/>cómo será z<sub>t+k</sub>"]
